---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, KATEGORIEN } from '../../lib/posts.js';

export function getStaticPaths() {
  return KATEGORIEN.map((k) => ({ params: { cat: k.slug }, props: { kat: k } }));
}
const { kat } = Astro.props;
const posts = getPosts().filter((p) => p.kategorie === kat.slug);
---
<Base title={`${kat.name} | Radius56`}>
  <nav class="chips" aria-label="Kategorien">
    <a class="chip" href="/">Alle</a>
    {KATEGORIEN.map((k) => <a class={`chip ${k.slug === kat.slug ? 'active' : ''}`} href={`/kategorie/${k.slug}`}>{k.name}</a>)}
  </nav>
  <div class="section-title"><h2>{kat.name}</h2></div>
  {posts.length > 0 ? (
    <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
  ) : (
    <div class="empty">
      <h2>Noch nichts in „{kat.name}“</h2>
      {kat.slug === 'immo'
        ? <p>Hier zeigen wir bald Häuser und Wohnungen aus dem Umkreis. Du bist Makler oder verkaufst privat?</p>
        : <p>Sobald es hier Neues gibt, findest du es an dieser Stelle. Du weißt schon etwas?</p>}
      <a class="button orange" href={kat.slug === 'immo' ? '/werben' : '/mitmachen'}>
        {kat.slug === 'immo' ? 'Objekt einstellen' : 'Tipp senden'}
      </a>
    </div>
  )}
</Base>
