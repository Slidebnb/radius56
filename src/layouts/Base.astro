---
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';

const {
  title = 'Radius56 – Lokale News für Neuwied, Koblenz & Umgebung',
  description = 'Was bei dir um die Ecke passiert: News, Events und Blaulicht aus Neuwied, Koblenz, Andernach und 30 km drumherum.',
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Start' },
  { href: '/kategorie/news', label: 'News' },
  { href: '/kategorie/events', label: 'Events' },
  { href: '/kategorie/blaulicht', label: 'Blaulicht' },
  { href: '/kategorie/immo', label: 'Immo' },
  { href: '/werben', label: 'Werben' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Radius56 Startseite">
          <Logo size={42} />
          <span class="brand-word">radius<span>56</span></span>
        </a>
        <nav class="nav" aria-label="Hauptnavigation">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || path === n.href + '/' ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="cta" href="/mitmachen">Tipp senden</a>
        </nav>
      </div>
    </header>
    <main id="inhalt" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container cols">
        <div>
          <strong style="color:#fff;font-family:var(--font-display);font-size:20px">radius<span style="color:var(--orange)">56</span></strong>
          <p style="margin:6px 0 0">Lokale News für Neuwied, Koblenz &amp; 30 km drumherum.<br />Ein Angebot von Radius Media.</p>
        </div>
        <nav aria-label="Rechtliches">
          <a href="/mitmachen">Mitmachen</a>
          <a href="/werben">Werben</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
          <a href="https://instagram.com/radius56.de" rel="noopener">Instagram</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
